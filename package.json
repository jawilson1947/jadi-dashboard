{
  "name": "jadi-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx src/worker.ts",
    "db:migrate": "tsx scripts/migrate-app-db.ts",
    "test:staging": "cross-env VITEST_STAGING=1 vitest run",
    "snapshot:once": "tsx scripts/snapshot-once.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "reset:credentials": "tsx scripts/reset-credentials.ts"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "mssql": "^12.7.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
